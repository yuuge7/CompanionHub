# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ===== Signing secrets — NEVER commit these =====
# Release keystore lives in the project root; back it up somewhere safe.
*.jks
*.keystore
android/key.properties
# Base64 export used when copying the key to CI / another machine
*.jks.base64

# Gradle
.gradle/
android/.gradle/
android/local.properties
android/captures/

# Built APKs / bundles produced by the release workflow
*.apk
*.aab

# Environment / editor
.env
*.bak
